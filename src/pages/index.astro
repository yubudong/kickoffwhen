---
const title = 'KickoffWhen — 2026 World Cup Local Kickoff Times for Asia';
const description =
  'Coming soon: Know exactly when every 2026 World Cup match starts in YOUR time. Built for fans in Japan, Korea, Taiwan, Hong Kong and Southeast Asia.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://kickoffwhen.com/" />
    <link rel="alternate" hreflang="en" href="https://kickoffwhen.com/" />
    <link rel="alternate" hreflang="ja" href="https://kickoffwhen.com/ja/" />
    <link rel="alternate" hreflang="x-default" href="https://kickoffwhen.com/" />

    <meta property="og:title" content="KickoffWhen — 2026 World Cup Local Kickoff Times" />
    <meta property="og:description" content="Know when every 2026 World Cup match starts in YOUR time." />
    <meta property="og:url" content="https://kickoffwhen.com/" />
    <meta property="og:type" content="website" />
  </head>
  <body class="bg-navy text-panel min-h-screen flex items-center justify-center p-5 font-sans">
    <main class="max-w-xl text-center">
      <h1 class="text-4xl sm:text-5xl font-bold mb-2">
        Kickoff<span class="text-moon">When</span> 🌙⚽
      </h1>
      <p class="text-base sm:text-lg text-slate leading-relaxed my-4">
        Know exactly when every 2026 World Cup match starts in YOUR time. Built for fans in
        Japan, Korea, Taiwan, Hong Kong and Southeast Asia.
      </p>
      <p class="text-base sm:text-lg text-slate leading-relaxed my-4">
        2026 W杯の全試合を日本時間で。徹夜価値スコア付き、近日公開。
      </p>

      <div class="my-9" aria-live="polite">
        <div class="text-xs text-slate mb-3 uppercase tracking-wider">
          Tournament kicks off in · 開幕まで
        </div>
        <div class="grid grid-cols-4 gap-2 max-w-md mx-auto" id="countdown">
          <div class="bg-moon/10 border border-moon/20 rounded-xl px-1 py-3">
            <div class="text-2xl sm:text-3xl font-bold text-moon tabular-nums leading-none" id="d">--</div>
            <div class="text-xs text-slate mt-1.5">days · 日</div>
          </div>
          <div class="bg-moon/10 border border-moon/20 rounded-xl px-1 py-3">
            <div class="text-2xl sm:text-3xl font-bold text-moon tabular-nums leading-none" id="h">--</div>
            <div class="text-xs text-slate mt-1.5">hours · 時</div>
          </div>
          <div class="bg-moon/10 border border-moon/20 rounded-xl px-1 py-3">
            <div class="text-2xl sm:text-3xl font-bold text-moon tabular-nums leading-none" id="m">--</div>
            <div class="text-xs text-slate mt-1.5">min · 分</div>
          </div>
          <div class="bg-moon/10 border border-moon/20 rounded-xl px-1 py-3">
            <div class="text-2xl sm:text-3xl font-bold text-moon tabular-nums leading-none" id="s">--</div>
            <div class="text-xs text-slate mt-1.5">sec · 秒</div>
          </div>
        </div>
      </div>

      <p class="mt-12 text-xs text-slate-dim">
        kickoffwhen.com is not affiliated with FIFA. Match information is for reference only.
      </p>
    </main>

    <script is:inline>
      (function () {
        var KICKOFF = Date.UTC(2026, 5, 11, 0, 0, 0);
        var els = {
          d: document.getElementById('d'),
          h: document.getElementById('h'),
          m: document.getElementById('m'),
          s: document.getElementById('s'),
        };
        function pad(n) {
          return n < 10 ? '0' + n : '' + n;
        }
        function tick() {
          var diff = KICKOFF - Date.now();
          if (diff <= 0) {
            document.getElementById('countdown').innerHTML =
              '<div class="col-span-4 text-pitch font-semibold">🎉 The 2026 tournament is live · 大会開催中</div>';
            clearInterval(timer);
            return;
          }
          els.d.textContent = Math.floor(diff / 86400000);
          els.h.textContent = pad(Math.floor((diff % 86400000) / 3600000));
          els.m.textContent = pad(Math.floor((diff % 3600000) / 60000));
          els.s.textContent = pad(Math.floor((diff % 60000) / 1000));
        }
        tick();
        var timer = setInterval(tick, 1000);
      })();
    </script>
  </body>
</html>
