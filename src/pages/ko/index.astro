---
import matchesData from '../../data/matches.json';
import teamsData from '../../data/teams.json';
import MatchCard from '../../components/MatchCard.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const locale = 'ko';
const defaultTz = 'Asia/Seoul';

const matches = [...matchesData].sort((a, b) => a.kickoff_utc < b.kickoff_utc ? -1 : 1);

function dateKey(utcIso) {
  const d = new Date(utcIso);
  const parts = new Intl.DateTimeFormat('en-CA', {
    timeZone: defaultTz, year: 'numeric', month: '2-digit', day: '2-digit'
  }).formatToParts(d);
  const lookup = Object.fromEntries(parts.filter(p => p.type !== 'literal').map(p => [p.type, p.value]));
  return `${lookup.year}-${lookup.month}-${lookup.day}`;
}

const groupedByDate = new Map();
for (const m of matches) {
  const key = dateKey(m.kickoff_utc);
  if (!groupedByDate.has(key)) groupedByDate.set(key, []);
  groupedByDate.get(key).push(m);
}
const sortedDays = Array.from(groupedByDate.entries()).sort((a, b) => a[0] < b[0] ? -1 : 1);

function formatDayHeader(dateIso) {
  const d = new Date(dateIso + 'T12:00:00Z');
  return new Intl.DateTimeFormat('ko-KR', {
    month: 'long', day: 'numeric', weekday: 'short'
  }).format(d);
}

const now = Date.now();
const upcoming = matches.filter(m => new Date(m.kickoff_utc).getTime() > now);
const nextMatch = upcoming[0] || null;
const topPicks = [...upcoming].slice(0, 24).sort((a, b) => (b.match_appeal || 0) - (a.match_appeal || 0)).slice(0, 3);

const totalMatches = matches.length;
const title = '2026 월드컵 한국시간 일정｜킥오프 시간 - KickoffWhen';
const description = '2026년 북중미 월드컵 전 경기를 한국시간으로. 경기별 「밤샘 가치 점수」 제공, 원클릭 캘린더 등록. 아시아 7개국 시간대 대응.';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://kickoffwhen.com/ko/" />
    <link rel="alternate" hreflang="en" href="https://kickoffwhen.com/" />
    <link rel="alternate" hreflang="ja" href="https://kickoffwhen.com/ja/" />
    <link rel="alternate" hreflang="ko" href="https://kickoffwhen.com/ko/" />
    <link rel="alternate" hreflang="zh-Hant" href="https://kickoffwhen.com/zh/" />
    <link rel="alternate" hreflang="x-default" href="https://kickoffwhen.com/" />

    <meta property="og:title" content="2026 월드컵 한국시간 일정｜킥오프 시간" />
    <meta property="og:description" content="2026 FIFA 월드컵 104경기 한국시간·일본시간·아시아 7개 도시 표시. 밤샘 가치 점수와 캘린더 등록 지원." />
    <meta property="og:url" content="https://kickoffwhen.com/ko/" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://kickoffwhen.com/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://kickoffwhen.com/og-image.png" />
    <meta property="og:locale" content="ko_KR" />
  </head>
  <body class="bg-navy text-panel min-h-screen font-sans">

    <SiteHeader locale={locale} defaultTz={defaultTz} />

    <main class="max-w-3xl mx-auto px-4 pb-16">

      <section class="text-center pt-8 sm:pt-12 pb-6">
        <h1 class="text-3xl sm:text-4xl font-bold mb-3 leading-tight">
          2026 월드컵<br/>
          <span class="text-moon">전 경기를 한국시간으로</span>.
        </h1>
        <p class="text-slate text-sm sm:text-base mb-7 max-w-lg mx-auto">
          전 {totalMatches} 경기・48개국.
          경기별 밤샘 가치 점수로, 밤샘할 가치가 있는지 한눈에.
        </p>

        <div class="my-6" aria-live="polite">
          <div class="text-xs text-slate mb-2.5 uppercase tracking-wider">대회 개막까지</div>
          <div class="grid grid-cols-4 gap-2 max-w-sm mx-auto" id="countdown">
            <div class="bg-moon/10 border border-moon/20 rounded-xl px-1 py-2.5">
              <div class="text-xl sm:text-2xl font-bold text-moon tabular-nums leading-none" id="cd-d">--</div>
              <div class="text-[10px] text-slate mt-1">일</div>
            </div>
            <div class="bg-moon/10 border border-moon/20 rounded-xl px-1 py-2.5">
              <div class="text-xl sm:text-2xl font-bold text-moon tabular-nums leading-none" id="cd-h">--</div>
              <div class="text-[10px] text-slate mt-1">시</div>
            </div>
            <div class="bg-moon/10 border border-moon/20 rounded-xl px-1 py-2.5">
              <div class="text-xl sm:text-2xl font-bold text-moon tabular-nums leading-none" id="cd-m">--</div>
              <div class="text-[10px] text-slate mt-1">분</div>
            </div>
            <div class="bg-moon/10 border border-moon/20 rounded-xl px-1 py-2.5">
              <div class="text-xl sm:text-2xl font-bold text-moon tabular-nums leading-none" id="cd-s">--</div>
              <div class="text-[10px] text-slate mt-1">초</div>
            </div>
          </div>
        </div>
      </section>

      {nextMatch && (
        <section class="mb-10">
          <h2 class="text-sm font-bold uppercase tracking-wider text-slate mb-3">⚡ 다음 경기</h2>
          <MatchCard match={nextMatch} teams={teamsData} locale={locale} defaultTz={defaultTz} />
        </section>
      )}

      {topPicks.length > 0 && (
        <section class="mb-10">
          <h2 class="text-sm font-bold uppercase tracking-wider text-slate mb-3">🌙 밤샘 가치가 높은 경기</h2>
          <div class="grid gap-3">
            {topPicks.map(m => <MatchCard match={m} teams={teamsData} locale={locale} defaultTz={defaultTz} />)}
          </div>
        </section>
      )}

      <section>
        <h2 class="text-sm font-bold uppercase tracking-wider text-slate mb-4">📅 전체 일정</h2>
        {sortedDays.map(([dayIso, dayMatches]) => (
          <div class="mb-8">
            <h3 class="text-base font-bold text-moon mb-3 sticky top-[73px] sm:top-[89px] bg-navy/95 backdrop-blur py-2 -mx-4 px-4 border-b border-slate/10">
              <span class="day-header" data-iso={dayIso}>{formatDayHeader(dayIso)}</span>
            </h3>
            <div class="grid gap-3">
              {dayMatches.map(m => <MatchCard match={m} teams={teamsData} locale={locale} defaultTz={defaultTz} />)}
            </div>
          </div>
        ))}
      </section>

    </main>

    <SiteFooter locale={locale} />

    <script type="application/json" id="page-config" set:html={JSON.stringify({ locale, defaultTz, asianCodes: ['JPN','KOR','AUS','IRN','KSA','UZB','JOR','IRQ','QAT'] })} />

    <script>
      import { formatLocalTime, getLocalParts, detectUserTimezone } from '../../lib/timezone.js';
      import { calcNightOwlScore } from '../../lib/score.js';
      import { getFavorites } from '../../lib/favorites.js';

      const cfg = JSON.parse(document.getElementById('page-config').textContent);

      (function () {
        const KICKOFF = Date.UTC(2026, 5, 11, 0, 0, 0);
        const els = { d: document.getElementById('cd-d'), h: document.getElementById('cd-h'), m: document.getElementById('cd-m'), s: document.getElementById('cd-s') };
        function pad(n) { return n < 10 ? '0' + n : '' + n; }
        function tick() {
          const diff = KICKOFF - Date.now();
          if (diff <= 0) {
            const cd = document.getElementById('countdown');
            if (cd) cd.innerHTML = '<div class="col-span-4 text-pitch font-semibold">🎉 대회 진행 중</div>';
            clearInterval(timer);
            return;
          }
          els.d.textContent = Math.floor(diff / 86400000);
          els.h.textContent = pad(Math.floor((diff % 86400000) / 3600000));
          els.m.textContent = pad(Math.floor((diff % 3600000) / 60000));
          els.s.textContent = pad(Math.floor((diff % 60000) / 1000));
        }
        tick();
        const timer = setInterval(tick, 1000);
      })();

      const STORAGE_KEY = 'kickoffwhen.timezone';
      const select = document.getElementById('tz-select');

      function currentTz() {
        const val = select.value;
        return val === 'auto' ? detectUserTimezone() : val;
      }

      function rerenderAll() {
        const tz = currentTz();
        const favorites = getFavorites();
        document.querySelectorAll('.match-card').forEach(card => {
          const utc = card.dataset.utc;
          if (!utc) return;

          const parts = getLocalParts(utc, tz, cfg.locale);
          const timeEl = card.querySelector('.kickoff-time');
          if (timeEl && parts) {
            timeEl.textContent = `${parts.month}/${parts.day} ${String(parts.hour).padStart(2,'0')}:${parts.minute} (${parts.weekday})`;
          }

          const match = {
            kickoff_utc: utc,
            home_code: card.dataset.homeCode || null,
            away_code: card.dataset.awayCode || null,
            home_slug: card.dataset.homeSlug || null,
            away_slug: card.dataset.awaySlug || null,
            match_appeal: parseFloat(card.dataset.matchAppeal) || 2,
          };
          const score = calcNightOwlScore(match, { locale: cfg.locale, timezone: tz, favoriteTeams: favorites });
          const starsEl = card.querySelector('.night-owl-stars');
          if (starsEl) {
            starsEl.textContent = score.stars;
            starsEl.title = `Raw ${score.raw}`;
          }
        });
      }

      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) {
        const opt = Array.from(select.options).find(o => o.value === saved);
        if (opt) select.value = saved;
      }
      if (select.value === 'auto' || select.value !== cfg.defaultTz) rerenderAll();

      select.addEventListener('change', () => {
        localStorage.setItem(STORAGE_KEY, select.value);
        rerenderAll();
      });

      window.addEventListener('favorites-change', rerenderAll);
    </script>

  </body>
</html>
