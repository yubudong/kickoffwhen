---
import matchesData from '../../data/matches.json';
import teamsData from '../../data/teams.json';
import { getLocalParts } from '../../lib/timezone.js';
import { calcNightOwlScore } from '../../lib/score.js';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import MultiTimezoneTable from '../../components/MultiTimezoneTable.astro';

export function getStaticPaths() {
  return matchesData.map(m => ({ params: { id: m.id }, props: { match: m } }));
}

const { match } = Astro.props;
const locale = 'en';
const defaultTz = 'Asia/Tokyo';

const STAGE_LABELS = {
  'group': 'Group stage',
  'round-of-32': 'Round of 32',
  'round-of-16': 'Round of 16',
  'quarter-final': 'Quarter-final',
  'semi-final': 'Semi-final',
  'third-place': 'Third-place play-off',
  'final': 'Final',
};
const stageLabel = STAGE_LABELS[match.stage] || match.stage;
const stageSub = match.stage === 'group' && match.group
  ? `Group ${match.group} · Matchday ${match.matchday}`
  : stageLabel;

// 球队信息
function teamBySlug(slug) {
  return slug ? teamsData[slug] : null;
}
const homeInfo = teamBySlug(Object.keys(teamsData).find(s => teamsData[s].name_en === match.home_team));
const awayInfo = teamBySlug(Object.keys(teamsData).find(s => teamsData[s].name_en === match.away_team));

function teamDisplay(info, fallback) {
  return info
    ? { name: info.name_en, flag: info.flag, slug: info.slug }
    : { name: fallback, flag: '⏳', slug: null };
}
const home = teamDisplay(homeInfo, match.home_team);
const away = teamDisplay(awayInfo, match.away_team);

// 服务端预算分（JST 视角）+ 主时间显示
const parts = getLocalParts(match.kickoff_utc, defaultTz, locale);
const initialTimeStr = parts ? `${parts.month}/${parts.day} ${String(parts.hour).padStart(2,'0')}:${parts.minute}` : 'TBA';
const weekdayStr = parts ? parts.weekday : '';
const initialScore = calcNightOwlScore(match, { locale, timezone: defaultTz });

const REASON_LABELS = {
  home_country:  'Home team match',
  asian_team:    'Asian team in match',
  favorite:      'Your favorite team',
  high_appeal:   'High-profile match',
  late_night:    'Late night (00–02)',
  deep_night:    'Deep night (03–05)',
  early_morning: 'Early morning (06–08)',
};

// SEO — search-friendly: "{team1} vs {team2} kickoff time in Japan / Asia"
const title = `${home.name} vs ${away.name} · ${stageSub} Kickoff Time (JST / Asia) — KickoffWhen`;
const description = `${home.name} vs ${away.name} kicks off ${match.date} at ${match.kickoff_local || 'TBD'} local time (${match.venue_name || 'venue TBD'}). See the time in JST, KST and 5 more Asian zones, plus a night-owl score.`;
const canonical = `https://kickoffwhen.com/match/${match.id}/`;

// Schema.org SportsEvent JSON-LD
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: `${home.name} vs ${away.name}`,
  description,
  startDate: match.kickoff_utc,
  sport: 'Soccer',
  url: canonical,
  location: match.venue_name ? {
    '@type': 'Place',
    name: match.venue_name,
    address: {
      '@type': 'PostalAddress',
      addressLocality: match.venue_city,
    },
  } : undefined,
  homeTeam: { '@type': 'SportsTeam', name: home.name },
  awayTeam: { '@type': 'SportsTeam', name: away.name },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="ja" href={`https://kickoffwhen.com/ja/match/${match.id}`} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <meta property="og:title" content={`${home.name} vs ${away.name} — ${stageSub}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="article" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-navy text-panel min-h-screen font-sans">

    <SiteHeader locale={locale} defaultTz={defaultTz} />

    <main class="max-w-3xl mx-auto px-4 pt-6 pb-16">

      <nav class="text-xs mb-4">
        <a href="/" class="text-slate hover:text-moon">← Back to schedule</a>
      </nav>

      <article
        data-match-id={match.id}
        data-utc={match.kickoff_utc}
        data-home-code={match.home_code || ''}
        data-away-code={match.away_code || ''}
        data-home-slug={home.slug || ''}
        data-away-slug={away.slug || ''}
        data-match-appeal={match.match_appeal}
      >
        <!-- Stage tag -->
        <div class="text-center mb-4">
          <span class="inline-block px-3 py-1 rounded-full bg-moon/10 text-moon text-xs font-semibold uppercase tracking-wider">
            {stageSub} · {match.match_label}
          </span>
        </div>

        <!-- Teams -->
        <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-3 sm:gap-6 mb-6">
          {home.slug ? (
            <a href={`/team/${home.slug}`} class="text-center no-underline hover:opacity-80 transition-opacity">
              <div class="text-5xl sm:text-6xl mb-2">{home.flag}</div>
              <div class="font-bold text-base sm:text-xl">{home.name}</div>
            </a>
          ) : (
            <div class="text-center">
              <div class="text-5xl sm:text-6xl mb-2">{home.flag}</div>
              <div class="font-bold text-base sm:text-xl text-slate-dim">{home.name}</div>
            </div>
          )}
          <div class="text-slate-dim text-sm font-bold">vs</div>
          {away.slug ? (
            <a href={`/team/${away.slug}`} class="text-center no-underline hover:opacity-80 transition-opacity">
              <div class="text-5xl sm:text-6xl mb-2">{away.flag}</div>
              <div class="font-bold text-base sm:text-xl">{away.name}</div>
            </a>
          ) : (
            <div class="text-center">
              <div class="text-5xl sm:text-6xl mb-2">{away.flag}</div>
              <div class="font-bold text-base sm:text-xl text-slate-dim">{away.name}</div>
            </div>
          )}
        </div>

        <!-- Big kickoff time -->
        <section class="bg-moon/5 border border-moon/30 rounded-2xl p-5 sm:p-6 text-center mb-6">
          <div class="text-xs text-slate mb-2 uppercase tracking-wider">
            Kickoff (<span class="kickoff-tz-label">JST</span>)
          </div>
          <div class="text-4xl sm:text-5xl font-bold text-moon tabular-nums kickoff-time-big mb-1" data-utc={match.kickoff_utc}>
            {initialTimeStr}
          </div>
          <div class="text-sm text-slate kickoff-weekday">{weekdayStr}</div>
          <div class="mt-4 text-xs text-slate-dim">
            <span class="countdown" data-utc={match.kickoff_utc}>—</span>
          </div>
        </section>

        <!-- Night-owl score -->
        <section class="bg-navy/40 border border-slate/20 rounded-2xl p-5 mb-6 text-center">
          <div class="text-xs text-slate mb-2 uppercase tracking-wider">Night-owl score</div>
          <div class="text-3xl mb-2 night-owl-stars">{initialScore.stars}</div>
          <div class="text-sm text-slate-dim night-owl-reason">
            {initialScore.reasons.length > 0
              ? initialScore.reasons.map(r => REASON_LABELS[r] || r).join(' · ')
              : 'Neutral match'}
          </div>
        </section>

        <!-- Multi-timezone table -->
        <div class="mb-6">
          <MultiTimezoneTable utcIso={match.kickoff_utc} locale={locale} />
        </div>

        <!-- Venue -->
        {match.venue_name && (
          <section class="bg-navy/40 border border-slate/20 rounded-2xl p-5 mb-6">
            <h3 class="text-sm font-bold uppercase tracking-wider text-slate mb-3">📍 Venue</h3>
            <div class="font-semibold text-panel mb-1">{match.venue_name}</div>
            <div class="text-sm text-slate">{match.venue_city}</div>
            {match.kickoff_local && (
              <div class="text-xs text-slate-dim mt-2">Local kickoff: {match.kickoff_local} ({match.venue_timezone})</div>
            )}
          </section>
        )}

      </article>

      <!-- Reason labels for client JS -->
      <script type="application/json" id="page-config" set:html={JSON.stringify({ locale, defaultTz, reasonLabels: REASON_LABELS })} />

    </main>

    <SiteFooter locale={locale} />

    <script>
      import { getLocalParts, detectUserTimezone, ASIA_TIMEZONES } from '../../lib/timezone.js';
      import { calcNightOwlScore } from '../../lib/score.js';

      const cfg = JSON.parse(document.getElementById('page-config').textContent);

      const STORAGE_KEY = 'kickoffwhen.timezone';
      const select = document.getElementById('tz-select');

      function currentTz() {
        const val = select.value;
        return val === 'auto' ? detectUserTimezone() : val;
      }

      function tzLabel(tzId) {
        if (tzId === 'auto' || !tzId) return 'local';
        const found = ASIA_TIMEZONES.find(t => t.id === tzId);
        return found ? found.label : tzId.split('/')[1] || tzId;
      }

      function rerender() {
        const tz = currentTz();
        const matchEl = document.querySelector('[data-match-id]');
        if (!matchEl) return;
        const utc = matchEl.dataset.utc;
        const parts = getLocalParts(utc, tz, cfg.locale);

        // Big kickoff time
        const timeEl = document.querySelector('.kickoff-time-big');
        const wdEl   = document.querySelector('.kickoff-weekday');
        const tzLabelEl = document.querySelector('.kickoff-tz-label');
        if (parts) {
          if (timeEl) timeEl.textContent = `${parts.month}/${parts.day} ${String(parts.hour).padStart(2,'0')}:${parts.minute}`;
          if (wdEl)   wdEl.textContent = parts.weekday;
        }
        if (tzLabelEl) tzLabelEl.textContent = tzLabel(select.value);

        // Score
        const match = {
          kickoff_utc: utc,
          home_code: matchEl.dataset.homeCode || null,
          away_code: matchEl.dataset.awayCode || null,
          home_slug: matchEl.dataset.homeSlug || null,
          away_slug: matchEl.dataset.awaySlug || null,
          match_appeal: parseFloat(matchEl.dataset.matchAppeal) || 2,
        };
        const score = calcNightOwlScore(match, { locale: cfg.locale, timezone: tz });
        const starsEl = document.querySelector('.night-owl-stars');
        if (starsEl) starsEl.textContent = score.stars;
        const reasonEl = document.querySelector('.night-owl-reason');
        if (reasonEl) {
          reasonEl.textContent = score.reasons.length > 0
            ? score.reasons.map(r => cfg.reasonLabels[r] || r).join(' · ')
            : 'Neutral match';
        }
      }

      // Countdown
      function updateCountdown() {
        const el = document.querySelector('.countdown');
        if (!el) return;
        const utc = el.dataset.utc;
        const diff = new Date(utc).getTime() - Date.now();
        if (diff <= 0) {
          el.textContent = '⚽ Match in progress or finished';
          return;
        }
        const d = Math.floor(diff / 86400000);
        const h = Math.floor((diff % 86400000) / 3600000);
        const m = Math.floor((diff % 3600000) / 60000);
        const s = Math.floor((diff % 60000) / 1000);
        el.textContent = `${d}d ${h}h ${m}m ${s}s until kickoff`;
      }

      // Apply saved timezone
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) {
        const opt = Array.from(select.options).find(o => o.value === saved);
        if (opt) select.value = saved;
      }
      if (select.value === 'auto' || select.value !== cfg.defaultTz) {
        rerender();
      } else {
        // ensure tz label is set even on first paint
        const tzLabelEl = document.querySelector('.kickoff-tz-label');
        if (tzLabelEl) tzLabelEl.textContent = tzLabel(select.value);
      }

      updateCountdown();
      setInterval(updateCountdown, 1000);

      select.addEventListener('change', () => {
        localStorage.setItem(STORAGE_KEY, select.value);
        rerender();
      });
    </script>

  </body>
</html>
