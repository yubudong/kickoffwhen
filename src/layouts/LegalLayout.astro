---
/**
 * LegalLayout — 法律 / 信息类页面共用的模板（about/privacy/terms/contact）
 *
 * Props:
 *   locale      'en' | 'ja' | 'ko' | 'zh'
 *   slug        'about' | 'privacy' | 'terms' | 'contact'
 *   title       完整 SEO title
 *   description meta description
 *   pageHeading 页面正文 H1（可省，会用 title 截断到第一个分隔符）
 */
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const { locale = 'en', slug, title, description, pageHeading } = Astro.props;

const HTML_LANG = { en: 'en', ja: 'ja', ko: 'ko', zh: 'zh-Hant' };
const DEFAULT_TZ = { en: 'Asia/Tokyo', ja: 'Asia/Tokyo', ko: 'Asia/Seoul', zh: 'Asia/Taipei' };

const LANG_PATH = { en: '', ja: 'ja/', ko: 'ko/', zh: 'zh/' };
const canonical = `https://kickoffwhen.com/${LANG_PATH[locale]}${slug}/`;
const altHref = (loc) => `https://kickoffwhen.com/${LANG_PATH[loc]}${slug}/`;

const heading = pageHeading || title.split(/[|·—-]/)[0].trim();
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={altHref('en')} />
    <link rel="alternate" hreflang="ja" href={altHref('ja')} />
    <link rel="alternate" hreflang="ko" href={altHref('ko')} />
    <link rel="alternate" hreflang="zh-Hant" href={altHref('zh')} />
    <link rel="alternate" hreflang="x-default" href={altHref('en')} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="article" />
  </head>
  <body class="bg-navy text-panel min-h-screen font-sans">

    <SiteHeader locale={locale} defaultTz={DEFAULT_TZ[locale]} />

    <main class="max-w-2xl mx-auto px-4 pt-8 pb-16">
      <h1 class="text-3xl sm:text-4xl font-bold mb-6 leading-tight">{heading}</h1>
      <article class="legal-content text-slate space-y-5 text-sm sm:text-base leading-relaxed">
        <slot />
      </article>
    </main>

    <SiteFooter locale={locale} />

    <style is:global>
      .legal-content h2 { font-size: 1.25rem; font-weight: 700; color: #F8FAFC; margin-top: 2rem; margin-bottom: 0.75rem; }
      .legal-content h3 { font-size: 1.05rem; font-weight: 600; color: #F8FAFC; margin-top: 1.5rem; margin-bottom: 0.5rem; }
      .legal-content p  { color: #9FB2CA; }
      .legal-content ul { list-style: disc; padding-left: 1.5rem; }
      .legal-content li { color: #9FB2CA; margin-bottom: 0.35rem; }
      .legal-content a  { color: #FFD600; }
      .legal-content a:hover { text-decoration: underline; }
      .legal-content code { background: rgba(255,255,255,0.06); padding: 0.1rem 0.4rem; border-radius: 4px; font-size: 0.85em; }
      .legal-content strong { color: #F8FAFC; }
    </style>

  </body>
</html>
