---
const { locale = 'en' } = Astro.props;

const TEXTS = {
  en: 'kickoffwhen.com is not affiliated with FIFA. Match information is for reference only.',
  ja: '本サイトはFIFA公式サイトではありません。試合情報は参考用です。',
  ko: '본 사이트는 FIFA 공식 사이트가 아닙니다. 경기 정보는 참고용입니다.',
  zh: '本網站非 FIFA 官方網站,賽事資訊僅供參考。',
};

const NAV_LABELS = {
  en: { about: 'About', privacy: 'Privacy', terms: 'Terms', contact: 'Contact' },
  ja: { about: 'About', privacy: 'プライバシー', terms: '利用規約', contact: 'お問い合わせ' },
  ko: { about: '소개', privacy: '개인정보', terms: '이용약관', contact: '문의' },
  zh: { about: '關於', privacy: '隱私權', terms: '使用條款', contact: '聯絡' },
};

const FEEDBACK = {
  ko: '한국어 번역에 대한 피드백은 GitHub에서 환영합니다',
  zh: '譯文建議歡迎透過 GitHub 反饋',
};

const prefix = locale === 'en' ? '' : `/${locale}`;
const t = NAV_LABELS[locale] || NAV_LABELS.en;
const footerText = TEXTS[locale] || TEXTS.en;
const feedbackText = FEEDBACK[locale];
const repoHref = 'https://github.com/yubudong/kickoffwhen/issues';
---

<footer class="border-t border-slate/10 mt-8 py-6 text-center text-xs text-slate-dim space-y-3">
  <nav class="flex justify-center gap-4 flex-wrap">
    <a href={`${prefix}/about/`} class="hover:text-moon">{t.about}</a>
    <span class="text-slate/30">·</span>
    <a href={`${prefix}/privacy/`} class="hover:text-moon">{t.privacy}</a>
    <span class="text-slate/30">·</span>
    <a href={`${prefix}/terms/`} class="hover:text-moon">{t.terms}</a>
    <span class="text-slate/30">·</span>
    <a href={`${prefix}/contact/`} class="hover:text-moon">{t.contact}</a>
  </nav>
  <p>{footerText}</p>
  {feedbackText && (
    <p>
      <a href={repoHref} class="hover:text-moon underline-offset-2 hover:underline" target="_blank" rel="noopener">{feedbackText}</a>
    </p>
  )}
</footer>
