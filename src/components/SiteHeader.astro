---
import TimezoneSwitcher from './TimezoneSwitcher.astro';

const { locale = 'en', defaultTz = 'Asia/Tokyo' } = Astro.props;

const LANG_LINKS = [
  { code: 'en', href: '/',     label: 'EN' },
  { code: 'ja', href: '/ja/',  label: '日' },
  { code: 'ko', href: '/ko/',  label: '한' },
  { code: 'zh', href: '/zh/',  label: '繁' },
];

const homeHref = `/${locale === 'en' ? '' : locale + '/'}`;
---

<header class="border-b border-slate/10 sticky top-0 z-40 bg-navy/95 backdrop-blur supports-[backdrop-filter]:bg-navy/70">
  <div class="max-w-3xl mx-auto px-4 py-3 flex items-center justify-between gap-3 flex-wrap">
    <a href={homeHref} class="block" aria-label="KickoffWhen home">
      <img src="/logo.svg" alt="KickoffWhen" width="155" height="40" class="h-8 sm:h-10 w-auto" />
    </a>
    <div class="flex items-center gap-3">
      <TimezoneSwitcher locale={locale} defaultTz={defaultTz} />
      <nav class="flex gap-0.5 text-xs">
        {LANG_LINKS.map(l => (
          <a
            href={l.href}
            class={`px-2 py-1 rounded ${l.code === locale ? 'bg-moon/15 text-moon font-semibold' : 'hover:bg-slate/10 text-slate'}`}
          >{l.label}</a>
        ))}
      </nav>
    </div>
  </div>
</header>
