---
import TimezoneSwitcher from './TimezoneSwitcher.astro';

const { locale = 'en', defaultTz = 'Asia/Tokyo' } = Astro.props;

const homeHref = locale === 'ja' ? '/ja/' : '/';
const enActive = locale === 'en';
const jaActive = locale === 'ja';
---

<header class="border-b border-slate/10 sticky top-0 z-40 bg-navy/95 backdrop-blur supports-[backdrop-filter]:bg-navy/70">
  <div class="max-w-3xl mx-auto px-4 py-3 flex items-center justify-between gap-4 flex-wrap">
    <a href={homeHref} class="font-bold text-lg sm:text-xl tracking-tight">
      Kickoff<span class="text-moon">When</span> <span aria-hidden="true">🌙⚽</span>
    </a>
    <div class="flex items-center gap-3">
      <TimezoneSwitcher locale={locale} defaultTz={defaultTz} />
      <nav class="flex gap-1 text-xs">
        <a href="/" class={`px-2 py-1 rounded ${enActive ? 'bg-moon/15 text-moon font-semibold' : 'hover:bg-slate/10 text-slate'}`}>EN</a>
        <a href="/ja/" class={`px-2 py-1 rounded ${jaActive ? 'bg-moon/15 text-moon font-semibold' : 'hover:bg-slate/10 text-slate'}`}>日</a>
      </nav>
    </div>
  </div>
</header>
