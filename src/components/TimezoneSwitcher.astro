---
import { ASIA_TIMEZONES, getCityLabel } from '../lib/timezone.js';

const { locale = 'en', defaultTz = 'Asia/Tokyo' } = Astro.props;

const LABELS = {
  en: { auto: 'Auto-detect', tz: 'Timezone' },
  ja: { auto: '自動検出',     tz: 'タイムゾーン' },
  ko: { auto: '자동 감지',    tz: '시간대' },
  zh: { auto: '自動偵測',     tz: '時區' },
};
const t = LABELS[locale] || LABELS.en;
---

<label class="tz-switcher inline-flex items-center gap-1.5 text-xs">
  <span class="text-slate">{t.tz}:</span>
  <select id="tz-select" class="bg-navy/80 border border-slate/30 rounded-md px-2 py-1 text-panel text-xs cursor-pointer hover:border-moon focus:border-moon focus:outline-none">
    <option value="auto">{t.auto}</option>
    {ASIA_TIMEZONES.map(tz => (
      <option value={tz.id} selected={tz.id === defaultTz}>
        {getCityLabel(tz, locale)} ({tz.label})
      </option>
    ))}
  </select>
</label>
