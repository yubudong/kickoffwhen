NODE_ENV=development
DATABASE_URL=postgres://app:app@localhost:5433/family_learning_dev
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=12345678901234567890123456789012
SMTP_URL=
SMTP_FROM=Family Learning <learn@kickoffwhen.com>
# Production accepts new guardians only from this comma-separated family list.
REGISTRATION_ALLOWED_EMAILS=
MEDIA_ROOT=./var/media
# Optional server-only Azure endpoints. Leave blank until external calls are explicitly enabled.
AZURE_SPEECH_ENDPOINT=
# Server-only secret; never commit or expose the real value to browser code, logs, tests, or reports.
AZURE_SPEECH_KEY=
AZURE_VISION_ENDPOINT=
# Server-only secret; keep the real value only in the deployment environment after authorization.
AZURE_VISION_KEY=
AUTH_TEST_EMAIL_ENABLED=false
# AUTH_TEST_EMAIL_SECRET=

# Enable only after configuring the F0 Speech resource. Run one worker.
AZURE_SPEECH_ENABLED=false
